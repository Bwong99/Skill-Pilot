# Copy this file to .env.local and fill in real values, then restart `npm run dev`.
# Without these, /explore and /dashboard return a 500 because the Supabase
# client is constructed at import time and throws when the URL and key are absent.

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# No Gemini key belongs here. Roadmap generation runs on the key each user
# saves under /profile, held in their own browser and passed per request.
# A server-owned GOOGLE_AI_API_KEY would bill public traffic to the app owner,
# so src/lib/ai-service.ts has no fallback to one by design.
