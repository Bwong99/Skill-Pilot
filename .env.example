# Copy this file to .env.local and fill in real values, then restart `npm run dev`.
# Without these, /explore and /dashboard return a 500 because the Supabase
# client is constructed at import time and throws when the URL and key are absent.

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google AI Studio (https://aistudio.google.com/apikey) - used by src/lib/ai-service.ts
GOOGLE_AI_API_KEY=your-gemini-api-key
